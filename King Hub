        end
    end
    return workspace:FindFirstChild("LootSpawns", true)
end

local function getcollectables()
    for _, child in pairs(workspace:GetChildren()) do
        if child:IsA("Model") or child:IsA("Folder") then
            local col = child:FindFirstChild("Collectables")
            if col then return col end
        end
    end
    return workspace:FindFirstChild("Collectables", true)
end

local function getitempos(item)
    if not item then return nil end
    local model = item:FindFirstChild("Model")
    if model then
        local handle = model:FindFirstChild("Handle")
        if handle then return handle.Position end
        return model:GetPivot().Position
    end
    if item:IsA("BasePart") then return item.Position end
    if item:IsA("Model") then return item:GetPivot().Position end
    local p = item:FindFirstChildWhichIsA("BasePart", true)
    if p then return p.Position end
    return nil
end

local function getitemvalue(item)
    local label = item:FindFirstChildWhichIsA("TextLabel", true)
    if label then
        return tonumber(label.Text:match("%d+")) or 0
    end
    return 0
end

local function iskillernear(dist)
    local hrp = gethrp()
    local killteam = teams:FindFirstChild("Killer")
    if hrp and killteam then
        for _, p in pairs(killteam:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local d = (p.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
                if d <= dist then
                    return true, p.Character.HumanoidRootPart.Position
                end
            end
        end
    end
    return false, nil
end

local function getplayerstat(statName)
    local direct = localplayer:FindFirstChild(statName, true)
    if direct and direct:IsA("ValueBase") then
        return direct.Value
    end
    local lstats = localplayer:FindFirstChild("leaderstats") or localplayer:FindFirstChild("Stats")
    if lstats then
        local found = lstats:FindFirstChild(statName, true)
        if found and found:IsA("ValueBase") then
            return found.Value
        end
    end
    return 0
end

local function executeExitTeleport()
    local hrp = gethrp()
    if not hrp then return end

    local doorFrame = nil
    for _, child in pairs(workspace:GetChildren()) do
        if child:IsA("Model") and child:FindFirstChild("Exits") then
            local exits = child.Exits:GetChildren()
            if #exits > 0 then
                local firstExit = exits[1]
                local doorway = firstExit:FindFirstChild("Doorway") or firstExit:FindFirstChildWhichIsA("Model", true)
                if doorway then
                    doorFrame = doorway:FindFirstChild("Frame") or doorway:FindFirstChildWhichIsA("BasePart", true)
                end
            end
            if doorFrame then break end
        end
    end

    if not doorFrame then
        local genericExits = workspace:FindFirstChild("Exits", true)
        if genericExits then
            local children = genericExits:GetChildren()
            if #children > 0 then
                local doorway = children[1]:FindFirstChild("Doorway")
                if doorway then
                    doorFrame = doorway:FindFirstChild("Frame")
                end
            end
        end
    end

    if doorFrame then
        local targetCFrame = doorFrame:IsA("BasePart") and doorFrame.CFrame or doorFrame:GetPivot()
        hrp.CFrame = targetCFrame

        task.wait(0.2)

        local currentHrp = gethrp()
        if currentHrp then
            currentHrp.CFrame = currentHrp.CFrame * CFrame.new(0, 0, 8)
            task.wait(2)
            currentHrp.CFrame = currentHrp.CFrame * CFrame.new(0, 0, -3)
        end
    end
end

local function create3DViewer(sourcefolder, title)
    local sg = Instance.new("ScreenGui")
    sg.Name = "Viewer3D_" .. title
    local success = pcall(function() sg.Parent = game:GetService("CoreGui") end)
    if not success then sg.Parent = localplayer:WaitForChild("PlayerGui") end
    
    local frame = Instance.new("Frame", sg)
    frame.Size = UDim2.new(0, 400, 0, 400)
    frame.Position = UDim2.new(0.5, -200, 0.5, -200)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    frame.Active = true
    frame.Draggable = true
    
    local titleLbl = Instance.new("TextLabel", frame)
    titleLbl.Size = UDim2.new(1, -40, 0, 30)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = title
    titleLbl.TextColor3 = Color3.new(1,1,1)
    
    local closeBtn = Instance.new("TextButton", frame)
    closeBtn.Size = UDim2.new(0, 30, 0, 30)
    closeBtn.Position = UDim2.new(1, -30, 0, 0)
    closeBtn.Text = "X"
    closeBtn.TextColor3 = Color3.new(1,0,0)
    closeBtn.MouseButton1Click:Connect(function() sg:Destroy() end)
    
    local vp = Instance.new("ViewportFrame", frame)
    vp.Size = UDim2.new(1, 0, 1, -60)
    vp.Position = UDim2.new(0, 0, 0, 30)
    vp.BackgroundTransparency = 1
    
    local cam = Instance.new("Camera")
    vp.CurrentCamera = cam
    cam.Parent = vp
    
    local items = sourcefolder:GetChildren()
    local idx = 1
    local currentModel = nil
    
    local nameLbl = Instance.new("TextLabel", frame)
    nameLbl.Size = UDim2.new(1, 0, 0, 30)
    nameLbl.Position = UDim2.new(0, 0, 1, -30)
    nameLbl.BackgroundTransparency = 1
    nameLbl.TextColor3 = Color3.new(1,1,1)
    
    local function updateView()
        if currentModel then currentModel:Destroy() end
        if #items == 0 then return end
        local item = items[idx]
        if item:IsA("Model") then
            currentModel = item:Clone()
        elseif item:IsA("BasePart") then
            currentModel = Instance.new("Model")
            local c = item:Clone()
            c.Parent = currentModel
            currentModel.PrimaryPart = c
        end
        
        if currentModel then
            currentModel.Parent = vp
            local cf = currentModel:GetPivot()
            currentModel:PivotTo(CFrame.new(0,0,0) * (cf - cf.Position))
            
            local extents = currentModel:GetExtentsSize()
            local max = math.max(extents.X, extents.Y, extents.Z)
            cam.CFrame = CFrame.new(Vector3.new(0, max/2, max * 1.5), currentModel:GetPivot().Position)
            nameLbl.Text = item.Name
        end
    end
    
    local nextBtn = Instance.new("TextButton", frame)
    nextBtn.Size = UDim2.new(0, 50, 0, 30)
    nextBtn.Position = UDim2.new(1, -50, 1, -30)
    nextBtn.Text = "->"
    nextBtn.MouseButton1Click:Connect(function()
        idx = idx + 1
        if idx > #items then idx = 1 end
        updateView()
    end)
    
    local prevBtn = Instance.new("TextButton", frame)
    prevBtn.Size = UDim2.new(0, 50, 0, 30)
    prevBtn.Position = UDim2.new(0, 0, 1, -30)
    prevBtn.Text = "<-"
    prevBtn.MouseButton1Click:Connect(function()
        idx = idx - 1
        if idx < 1 then idx = #items end
        updateView()
    end)
    
    local dragging = false
    local lastPos = nil
    local angleX, angleY = 0, 0
    
    vp.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            lastPos = input.Position
        end
    end)
    
    vp.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - lastPos
            lastPos = input.Position
            angleX = angleX - delta.X * 0.01
            angleY = math.clamp(angleY - delta.Y * 0.01, -math.pi/2.5, math.pi/2.5)
            
            if currentModel then
                local extents = currentModel:GetExtentsSize()
                local max = math.max(extents.X, extents.Y, extents.Z)
                local dist = max * 1.5
                
                local offset = CFrame.Angles(0, angleX, 0) * CFrame.Angles(angleY, 0, 0) * CFrame.new(0, 0, dist)
                cam.CFrame = CFrame.new(offset.Position, Vector3.new(0,0,0))
            end
        end
    end)
    
    updateView()
end

-- Red Effect toggle: hide only red-tinted full-screen overlays / red color correction.
-- This is a local visual filter; the exact game effect may vary between rounds.
local redEffectEnabled = false
local savedRedGui = {}
local savedRedColorCorrection = {}
local playerGui = localplayer:FindFirstChildOfClass("PlayerGui") or localplayer:WaitForChild("PlayerGui")

local function isStrongRed(color)
    return color.R >= 0.55 and color.R > color.G * 1.35 and color.R > color.B * 1.35
end

local function rememberAndHideRedGui(obj)
    if not redEffectEnabled or not obj:IsA("GuiObject") or savedRedGui[obj] then
        return
    end

    local camera = workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(800, 600)
    local size = obj.AbsoluteSize
    local fullScreenLike = size.X >= viewport.X * 0.70 and size.Y >= viewport.Y * 0.70
    if not fullScreenLike then
        return
    end

    local redBackground = false
    local redImage = false
    pcall(function()
        redBackground = obj.BackgroundTransparency < 1 and isStrongRed(obj.BackgroundColor3)
    end)
    pcall(function()
        redImage = obj.ImageTransparency < 1 and isStrongRed(obj.ImageColor3)
    end)

    if redBackground or redImage then
        savedRedGui[obj] = { Visible = obj.Visible }
        obj.Visible = false
    end
end

local function rememberAndNeutralizeRedCorrection(obj)
    if not redEffectEnabled or not obj:IsA("ColorCorrectionEffect") or savedRedColorCorrection[obj] then
        return
    end

    if isStrongRed(obj.TintColor) then
        savedRedColorCorrection[obj] = { TintColor = obj.TintColor }
        obj.TintColor = Color3.new(1, 1, 1)
    end
end

local function scanRedEffects()
    for _, obj in ipairs(playerGui:GetDescendants()) do
        rememberAndHideRedGui(obj)
    end
    for _, obj in ipairs(Lighting:GetDescendants()) do
        rememberAndNeutralizeRedCorrection(obj)
    end
    local camera = workspace.CurrentCamera
    if camera then
        for _, obj in ipairs(camera:GetDescendants()) do
            rememberAndNeutralizeRedCorrection(obj)
        end
    end
end

local function setRedEffect(enabled)
    redEffectEnabled = enabled
    if enabled then
        scanRedEffects()
    else
        for obj, values in pairs(savedRedGui) do
            if obj and obj.Parent then
                obj.Visible = values.Visible
            end
        end
        for obj, values in pairs(savedRedColorCorrection) do
            if obj and obj.Parent then
                obj.TintColor = values.TintColor
            end
        end
        table.clear(savedRedGui)
        table.clear(savedRedColorCorrection)
    end
end

playerGui.DescendantAdded:Connect(function(obj)
    if redEffectEnabled then
        task.defer(function()
            if obj and obj.Parent then
                rememberAndHideRedGui(obj)
            end
        end)
    end
end)

Lighting.DescendantAdded:Connect(function(obj)
    if redEffectEnabled then
        rememberAndNeutralizeRedCorrection(obj)
    end
end)

workspace.DescendantAdded:Connect(function(obj)
    if redEffectEnabled then
        rememberAndNeutralizeRedCorrection(obj)
    end
end)

