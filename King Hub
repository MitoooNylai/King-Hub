            killerspawnfolder:ClearAllChildren()
            for _, v in pairs(workspace:GetDescendants()) do
                if v.Name == "KillerSpawns" or v.Name == "KillerSpawn" then
                    if v:IsA("BasePart") then
                        v.Transparency = 0
                        applyhl(v, Color3.fromRGB(255, 0, 0), killerspawnfolder)
                    elseif v:IsA("Model") or v:IsA("Folder") then
                        for _, child in pairs(v:GetChildren()) do
