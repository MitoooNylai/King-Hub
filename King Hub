-- Local visual No Fog toggle for Survive the Killer
local noFogEnabled = false
local originalFogStart = Lighting.FogStart
local originalFogEnd = Lighting.FogEnd
local originalAtmosphere = {}

local function rememberAtmosphere(obj)
    if obj:IsA("Atmosphere") and not originalAtmosphere[obj] then
        originalAtmosphere[obj] = {
            Density = obj.Density,
            Haze = obj.Haze,
            Glare = obj.Glare,
        }
    end
end

for _, obj in ipairs(Lighting:GetDescendants()) do
    rememberAtmosphere(obj)
end

Lighting.DescendantAdded:Connect(function(obj)
    if obj:IsA("Atmosphere") then
        rememberAtmosphere(obj)
        if noFogEnabled then
            obj.Density = 0
            obj.Haze = 0
            obj.Glare = 0
        end
    end
end)

local function setNoFog(enabled)
    noFogEnabled = enabled

    if enabled then
        Lighting.FogStart = 0
        Lighting.FogEnd = 1000000

        for obj in pairs(originalAtmosphere) do
            if obj.Parent then
                obj.Density = 0
                obj.Haze = 0
                obj.Glare = 0
            end
        end
    else
        Lighting.FogStart = originalFogStart
        Lighting.FogEnd = originalFogEnd

        for obj, values in pairs(originalAtmosphere) do
            if obj.Parent then
                obj.Density = values.Density
                obj.Haze = values.Haze
                obj.Glare = values.Glare
            end
        end
    end
end

