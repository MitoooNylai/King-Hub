                    local val = p:FindFirstChild("CurrentKnife") or (p:FindFirstChild("leaderstats") and p.leaderstats:FindFirstChild("CurrentKnife"))
                    if val and val:IsA("StringValue") then
                        knifeId = val.Value
                    end
                end
                
                if knifeId then
                    local knifeData = KnivesDB[knifeId]
                    if knifeData then
                        local rarity = knifeData.Rarity
                        local value = rarityScores[rarity] or -1
                        
                        local isLimited = (rarity == Enums.Rarity.Limited) or (knifeData.LimitedType ~= nil)
                        if isLimited and value < 10 then
                            value = 10 
                        end

                        if value > highestValue then
                            highestValue = value
                            richestPlayer = p
                            bestKnifeData = knifeData
                            bestKnifeId = knifeId
                        end
                    end
                end
            end

            -- Time to show it off to the world! (or just you hehe)
            if richestPlayer and bestKnifeData then
                local isLimited = (bestKnifeData.Rarity == Enums.Rarity.Limited) or (bestKnifeData.LimitedType ~= nil)
                local limitedText = isLimited and "yes" or "no"
                local knifeName = bestKnifeData.Name or bestKnifeId
                
                startergui:SetCore("SendNotification", {
                    Title = "found",
                    Text = richestPlayer.Name .. "\nKnife; " .. knifeName .. "\nLimited; " .. limitedText,
                    Duration = 8,
                })
            else
                startergui:SetCore("SendNotification", {
                    Title = "error",
                    Text = "error",
                    Duration = 5,
                })
            end
        end)
    end
})
